# ImageKit (https://imagekit.io/dashboard/developer/api-keys)
# Haqiqiy qiymatlarni .env.local ga yozing — u Git'ga tushmaydi.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxx

# Telegram: saytga har kirilganda xabar (lib/telegram.ts)
# 1) @BotFather'da bot yarating va tokenni shu yerga yozing
# 2) O'zingiz botga /start yozing (bot sizga birinchi bo'lib yoza olmaydi)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_USERNAME=your_telegram_nick
# Ixtiyoriy, lekin ishonchliroq: birinchi xabardan keyin server logida chiqadi
TELEGRAM_CHAT_ID=
